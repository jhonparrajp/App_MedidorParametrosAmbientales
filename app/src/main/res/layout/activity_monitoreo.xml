<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Monitoreo">


    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/montserrat_variablefont_wght"
        android:text="Monitoreo"
        android:textColor="@color/AzulMenta"
        android:textSize="30sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="408dp"
        android:layout_height="44dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btGuardar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/estilo_boton_monitorear"
            android:fontFamily="@font/montserrat_variablefont_wght"
            android:onClick="guardar"
            android:text="Guardar"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnGraficas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/estilo_boton_monitorear"
            android:fontFamily="@font/montserrat_variablefont_wght"
            android:onClick="irGraficas"
            android:text="Graficas"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnTablas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/estilo_boton_monitorear"
            android:fontFamily="@font/montserrat_variablefont_wght"
            android:onClick="irTablas"
            android:text="Tablas"
            android:textColor="@color/white" />

    </LinearLayout>

    <Switch
        android:id="@+id/swMediciones"
        android:layout_width="189dp"
        android:layout_height="36dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/estilo_boton"
        android:fontFamily="@font/montserrat_variablefont_wght"
        android:text="Iniciar Mediciones"
        android:textColor="@color/white"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="UseSwitchCompatOrMaterialXml" />

    <FrameLayout
        android:id="@+id/frameLayout"
        android:layout_width="400dp"
        android:layout_height="70dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView2">

        <ProgressBar
            android:id="@+id/pbConductividad"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="350dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:max="1000"
            android:progressDrawable="@drawable/progressbar_conductividad"
            android:scaleY="1" />

        <TextView
            android:id="@+id/textView6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/montserrat_variablefont_wght"
            android:text="Conductividad"
            android:textAlignment="center"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvConductividad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/montserrat_variablefont_wght"
            android:text="Us/Cm"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textStyle="bold" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/frameLayout2"
        android:layout_width="400dp"
        android:layout_height="70dp"
        android:layout_marginStart="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/frameLayout">

        <ProgressBar
            android:id="@+id/pbTds"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="350dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:max="1000"
            android:progressDrawable="@drawable/progressbar_tds"
            android:scaleY="1" />

        <TextView
            android:id="@+id/textView7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/montserrat_variablefont_wght"
            android:text="Tds"
            android:textAlignment="center"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvTds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/montserrat_variablefont_wght"
            android:text="ppm"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textStyle="bold" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/frameLayout3"
        android:layout_width="400dp"
        android:layout_height="70dp"
        android:layout_marginStart="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/frameLayout2">

        <ProgressBar
            android:id="@+id/pbTempAgua"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="350dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:max="80"
            android:progressDrawable="@drawable/rounded_progress_bar"
            android:scaleY="1" />

        <TextView
            android:id="@+id/textView8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/montserrat_variablefont_wght"
            android:text="Temperatura Del agua"
            android:textAlignment="center"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvTempAgua"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/montserrat_variablefont_wght"
            android:text="°C"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textStyle="bold" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/frameLayout4"
        android:layout_width="400dp"
        android:layout_height="70dp"
        android:layout_marginStart="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/frameLayout3">

        <ProgressBar
            android:id="@+id/pbTempAire"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="350dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:max="80"
            android:progressDrawable="@drawable/progress_bar_tempaire"
            android:scaleY="1" />

        <TextView
            android:id="@+id/textView9"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginBottom="8dp"

            android:fontFamily="@font/montserrat_variablefont_wght"
            android:text="Temperatura Del Aire"
            android:textAlignment="center"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvTempAire"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/montserrat_variablefont_wght"
            android:text="°C"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textStyle="bold" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/frameLayout5"
        android:layout_width="400dp"
        android:layout_height="70dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/frameLayout4">

        <ProgressBar
            android:id="@+id/pbHumedad"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="350dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progressDrawable="@drawable/progressbar_humedad"
            android:scaleY="1" />

        <TextView
            android:id="@+id/textView10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/montserrat_variablefont_wght"
            android:text="Humedad Del Aire"
            android:textAlignment="center"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvHumedad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/montserrat_variablefont_wght"
            android:text="%"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textStyle="bold" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/frameLayout6"
        android:layout_width="400dp"
        android:layout_height="70dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.509"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/frameLayout5">

        <ProgressBar
            android:id="@+id/pbLuzVisible"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="350dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:max="700"
            android:min="400"
            android:progressDrawable="@drawable/progressbar_luzvisible"
            android:scaleY="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/textView12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/montserrat_variablefont_wght"
            android:text="Luz Visible"
            android:textAlignment="center"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvLuzVisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/montserrat_variablefont_wght"
            android:text="Luz"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textStyle="bold" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/frameLayout7"
        android:layout_width="400dp"

        android:layout_height="70dp"
        android:layout_marginStart="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.576"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/frameLayout6">

        <ProgressBar
            android:id="@+id/pbir"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="350dp"

            android:layout_height="32dp"
            android:layout_gravity="center"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:max="750"
            android:progressDrawable="@drawable/progressbar_ir"
            android:scaleY="1" />

        <TextView
            android:id="@+id/textView13"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/montserrat_variablefont_wght"
            android:text="IR"
            android:textAlignment="center"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvLuzIr"
            android:layout_width="wrap_content"

            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/montserrat_variablefont_wght"
            android:text="Luz IR"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textStyle="bold" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="400dp"
        android:layout_height="70dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.573"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/frameLayout7">

        <ProgressBar
            android:id="@+id/pbIndice"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="350dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:max="10"
            android:progressDrawable="@drawable/progressbar_indice_uv"
            android:scaleY="1" />

        <TextView
            android:id="@+id/textView11"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/montserrat_variablefont_wght"
            android:text="Indice UV"
            android:textAlignment="center"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvIndiceUv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"

            android:layout_marginTop="8dp"
            android:fontFamily="@font/montserrat_variablefont_wght"
            android:text="Indice"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textStyle="bold" />
    </FrameLayout>


</androidx.constraintlayout.widget.ConstraintLayout>