<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/> <!-- Bordes redondeados -->
            <solid android:color="#FAF3BB"/> <!-- Color del fondo -->
        </shape>
    </item>

    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="12dp"/> <!-- Bordes redondeados -->
                <gradient
                    android:endColor="#834F03"
                    android:centerColor="#FF9800"
                    android:startColor="#D1C664"
                    android:useLevel="true"/><!-- Color del progreso -->
            </shape>
        </clip>
    </item>
</layer-list>