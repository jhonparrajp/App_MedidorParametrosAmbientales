<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <item android:id="@android:id/background" tools:ignore="StateListReachable">
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/> <!-- Bordes redondeados -->
            <solid android:color="#EDBDAD"/> <!-- Color del fondo -->
        </shape>
    </item>

    <item android:id="@android:id/progress" tools:ignore="StateListReachable">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="12dp"/> <!-- Bordes redondeados -->
                <gradient
                    android:startColor="#E41414"
                    android:endColor="#F13A00"
                    android:useLevel="true"
                    /><!-- Color del progreso -->
            </shape>
        </clip>
    </item>
</layer-list>