<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android" tools:ignore="StateListReachable">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/> <!-- Bordes redondeados -->
            <solid android:color="@color/AzulCielo"/> <!-- Color del fondo -->
        </shape>
    </item>

    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="12dp"/> <!-- Bordes redondeados -->
                <gradient
                    android:endColor="@color/teal_700"
                    android:centerColor="@color/AzulMenta"
                    android:startColor="#CBF1F5"
                    android:useLevel="true"/> <!-- Color del progreso -->
            </shape>
        </clip>
    </item>
</layer-list>