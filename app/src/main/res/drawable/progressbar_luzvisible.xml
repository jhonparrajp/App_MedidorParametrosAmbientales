<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" tools:ignore="StateListReachable">
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/> <!-- Bordes redondeados -->
            <solid android:color="#FFFFFF"/> <!-- Color del fondo -->
        </shape>
    </item>

    <item android:id="@android:id/progress" tools:ignore="StateListReachable">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="12dp"/> <!-- Bordes redondeados -->
                <gradient
                    android:startColor="#6133B3"
                    android:centerColor="#228CE1"
                    android:endColor="#379C3B"
                    /> <!-- Color del progreso -->
            </shape>
        </clip>
    </item>
</layer-list>