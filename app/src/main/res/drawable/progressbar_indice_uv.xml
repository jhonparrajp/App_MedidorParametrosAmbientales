<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/> <!-- Bordes redondeados -->
            <solid android:color="#F6E0E0"/> <!-- Color del fondo -->
        </shape>
    </item>

    <item android:id="@android:id/progress" tools:ignore="StateListReachable">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="12dp"/> <!-- Bordes redondeados -->
                <gradient
                    android:startColor="#4CAF50"
                    android:centerColor="#FF5722"
                    android:endColor="#673AB7"
                    android:useLevel="true"
                /> <!-- Color del progreso -->
            </shape>
        </clip>
    </item>
</layer-list>